# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env de verdade.

# URL do banco Turso (libSQL). Formato local para desenvolvimento sem conta:
# file:./dev.db
# Formato de produção (Turso): libsql://<database>-<org>.turso.io
DATABASE_URL=file:./dev.db

# Token de autenticação do Turso. Só é necessário para o banco remoto de produção;
# deixe vazio ao usar o arquivo local acima.
TURSO_AUTH_TOKEN=

# Segredo usado para assinar os tokens JWT de sessão. Gere um valor aleatório forte,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-antes-de-subir-para-producao

# Porta do servidor HTTP local.
PORT=3333

# Origem permitida para requisições CORS (o endereço onde o frontend roda).
CORS_ORIGIN=http://localhost:5173
