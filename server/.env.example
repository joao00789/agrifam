# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env de verdade.

# Copie a URI PostgreSQL em Supabase > Connect. Mantenha ?sslmode=require.
# Codifique caracteres especiais da senha como URL encoding.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require

# Segredo usado para assinar os tokens JWT de sessão. Gere um valor aleatório forte,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Porta do servidor HTTP local.
PORT=3333

# Origem permitida para requisições CORS (o endereço onde o frontend roda).
CORS_ORIGIN=http://localhost:5173

# Login Google pelo Supabase Auth (ative Google em Authentication > Providers).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Uploads: crie um bucket público (por padrão: agrifam-images).
# A secret key fica somente no backend; nunca use no frontend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=agrifam-images
